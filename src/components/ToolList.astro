---
import { briefUrl, categories, companionUrl } from "../data/site";
---

<div class="categories">
  {categories.map((category) => (
    <div class="category">
      <h3>
        {category.name}
        {category.working.length + category.open.length > 0 && (
          <span>
            {category.working.length} of {category.working.length + category.open.length} working
          </span>
        )}
      </h3>
      <ul>
        {category.companions.map((card) => (
          <li class="companion">
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
            <a href={companionUrl(card)}>Opens {card.name}</a>
            <span class="sr">, a separate free app</span>
          </li>
        ))}
        {category.working.map((tool) => (
          <li class="working">
            <span class="dot" aria-hidden="true" />
            {tool.name}
            <span class="sr">, works today</span>
          </li>
        ))}
        {category.open.map((tool) => (
          <li class="open">
            <span class="dot" aria-hidden="true" />
            <a href={briefUrl(tool)}>{tool.name}</a>
            <span class="sr">, not built yet</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
